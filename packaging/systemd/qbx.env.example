# Example environment overrides for qbx (copy to /etc/qbx/qbx.env).
# Later layers win: defaults < provisional YAML < env/CLI < config.toml (WebUI).

# QBX_CONFIG_DIR=/var/lib/qbx
# QBX_SERVER__HOST=0.0.0.0
# QBX_SERVER__PORT=8484
# QBX_QBT__URL=http://127.0.0.1:8080
# QBX_QBT__USERNAME=admin
# QBX_QBT__PASSWORD=secret

# Debrid providers
# QBX_ALLDEBRID_API_KEY=
# QBX_ALLDEBRID_ENABLED=true
# QBX_ALLDEBRID_PRIORITY=0
# QBX_REALDEBRID_API_KEY=
# QBX_REALDEBRID_ENABLED=true
# QBX_REALDEBRID_PRIORITY=1
# Or JSON list: QBX_PROVIDERS=[{"name":"alldebrid","api_key":"...","enabled":true,"priority":0}]

# Proxy / anonymity
# QBX_ANONYMITY__ENABLED=true
# QBX_ANONYMITY__PROXY_URL=socks5://127.0.0.1:9050
# QBX_ANONYMITY__USE_PROXY_FOR_DEBRID=true
# QBX_ANONYMITY__USE_PROXY_FOR_DOWNLOADS=true

# QBX_INTERCEPTOR__DELIVERY_MODE=webseed
# QBX_INTERCEPTOR__STALLED_ONLY=true
# QBX_INTERCEPTOR__STALLED_MIN_MINUTES=30
# QBX_MATCHER__ENABLED=false
