# Copy to `.env` next to docker-compose.yml (optional).
# Precedence: Control Shell Settings (config.toml) > these env vars > provisional YAML.
# After the first container start, values are seeded into /config/config.toml; further
# changes are best done in the WebUI Settings panel (or by editing/removing config.toml).

QBX_PORT=8484
QBX_DOWNLOADS=./downloads

# qBittorrent
QBX_QBT__URL=http://host.docker.internal:8080
QBX_QBT__USERNAME=admin
QBX_QBT__PASSWORD=

# Debrid — enable one or both
QBX_ALLDEBRID_API_KEY=
QBX_ALLDEBRID_ENABLED=true
QBX_ALLDEBRID_PRIORITY=0
QBX_REALDEBRID_API_KEY=
QBX_REALDEBRID_ENABLED=true
QBX_REALDEBRID_PRIORITY=1

# Proxy (HTTP or SOCKS), e.g. socks5://127.0.0.1:9050 or http://user:pass@proxy:8080
QBX_ANONYMITY__ENABLED=true
QBX_ANONYMITY__PROXY_URL=
QBX_ANONYMITY__USE_PROXY_FOR_DEBRID=true
QBX_ANONYMITY__USE_PROXY_FOR_DOWNLOADS=true

QBX_INTERCEPTOR__DELIVERY_MODE=webseed
QBX_INTERCEPTOR__DOWNLOAD_DIR=/downloads
QBX_SERVER__LOG_LEVEL=INFO
